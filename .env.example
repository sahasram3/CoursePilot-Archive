# All settings are optional; defaults work for local use and single-container deploys.

# Port the server listens on (Docker image and most hosts set this for you).
PORT=8000

# Simultaneous plan solves. Each uses several CPU-seconds; extra requests receive HTTP 503.
PREREQPATH_MAX_CONCURRENT=2

# Catalog data directory (defaults to <repo>/data).
# PREREQPATH_DATA_DIR=/app/data

# Only when the frontend is hosted on a different origin than the API:
# PREREQPATH_CORS_ORIGINS=https://prereqpath.example.com
# and build the frontend with:
# VITE_API_BASE=https://api.prereqpath.example.com
