{"code":"PRSN 306","subject":"PRSN","number":"306","number_int":306,"title":"Persian Language through Literature and Film","credits_min":3.0,"credits_max":3.0,"description":"Students will study literary writings and filmic texts from traditional literature to contemporary media (including plays, film, television, etc.). Students will engage in various communicative activities focusing on all language skills and building vocabulary and idiomatic expressions. Literary and filmic texts will also improve students' cultural awareness.","gen_ed":[],"requisites_raw":"Prerequisite, PRSN 204.","prerequisites":{"kind":"course","code":"PRSN 204","concurrent_ok":false},"requisites_status":"parsed","requisites_notes":[],"same_as":[],"grading_status":"Letter grade.","source":{"url":"https://catalog.unc.edu/courses/prsn/","catalog_year":"2026-2027","section":"PRSN 306","text":"PRSN 306. | 3 Credits. | Prerequisite, PRSN 204 .","retrieved_at":"2026-10-18T00:46:23+00:00","sha256":"d8709b7cc8e1c1ca0231c4bdc67b4468b55905d7988248697c92dfe0dfcafb2c"}}
